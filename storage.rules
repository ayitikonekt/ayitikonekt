rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function admin() {
      return request.auth != null
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function support() {
      return request.auth != null
        && 'support' in request.auth.token
        && request.auth.token.support == true;
    }

    function validImage(maxBytes) {
      return request.resource != null
        && request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }

    function validMessageFile() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType.matches(
          '(image/(jpeg|png|webp)|application/pdf)'
        );
    }

    match /products/{uid}/{productId}/{fileName} {
      allow read: if true;
      allow create: if owner(uid)
        && resource == null
        && productId.matches('[A-Za-z0-9_-]{1,160}')
        && fileName.matches('[0-9]{10,20}\\.(jpg|png|webp|heic|heif)')
        && firestore.exists(
          /databases/(default)/documents/products/$(productId)
        )
        && firestore.get(
          /databases/(default)/documents/products/$(productId)
        ).data.sellerId == uid
        && validImage(8 * 1024 * 1024);
      allow update: if false;
      allow delete: if owner(uid);
    }

    // Solo lectura para imágenes creadas antes de incorporar propietario a la ruta.
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /profile_images/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if owner(uid) && validImage(5 * 1024 * 1024);
      allow delete: if owner(uid);
    }

    match /support_tickets/{uid}/{ticketId}/{fileName} {
      allow read: if owner(uid) || support() || admin();
      allow create: if owner(uid)
        && ticketId.matches('[A-Za-z0-9_-]{1,160}')
        && fileName.matches('[A-Za-z0-9_.-]{1,160}')
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update: if false;
      allow delete: if owner(uid) || admin();
    }

    // Los archivos se cargan en un espacio temporal propiedad del remitente.
    // Cloud Functions verifica que participe en la conversación antes de
    // incorporarlos a un mensaje.
    match /conversation_uploads/{uid}/{conversationId}/{fileName} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && conversationId.matches('[A-Za-z0-9_-]{1,700}')
        && fileName.matches('[A-Za-z0-9_.-]{1,160}')
        && validMessageFile();
      allow update: if false;
      allow delete: if owner(uid) || admin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
