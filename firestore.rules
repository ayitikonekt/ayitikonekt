rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function admin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.reputation == 5;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'lastName', 'phone', 'country', 'city', 'address',
          'language', 'photo'
        ]);
      allow delete: if false;

      match /favorites/{productId} {
        allow read: if owner(uid);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if owner(uid);
        allow update: if owner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.id == productId
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.views == 0
        && request.resource.data.favorites == 0
        && request.resource.data.isFeatured == false;
      allow update: if signedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'price', 'category', 'city', 'country',
          'address', 'latitude', 'longitude', 'images', 'condition',
          'isSold', 'updatedAt'
        ]);
      allow delete: if signedIn() && resource.data.sellerId == request.auth.uid;

      match /viewEvents/{viewerId} {
        allow read, write: if false;
      }
    }

    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'received';
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || admin());
      allow update, delete: if admin();
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantIds;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantIds;
        allow update, delete: if false;
      }
    }

    match /messages/{messageId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
