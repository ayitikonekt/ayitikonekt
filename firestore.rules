rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function admin() {
      return signedIn() && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function moderator() {
      return signedIn() && 'moderator' in request.auth.token
        && request.auth.token.moderator == true;
    }

    function support() {
      return signedIn() && 'support' in request.auth.token
        && request.auth.token.support == true;
    }

    function staff() {
      return admin() || moderator();
    }

    function validImageList(images) {
      return images is list
        && images.size() <= 8
        && (images.size() < 1 || (images[0] is string && images[0].size() <= 2048))
        && (images.size() < 2 || (images[1] is string && images[1].size() <= 2048))
        && (images.size() < 3 || (images[2] is string && images[2].size() <= 2048))
        && (images.size() < 4 || (images[3] is string && images[3].size() <= 2048))
        && (images.size() < 5 || (images[4] is string && images[4].size() <= 2048))
        && (images.size() < 6 || (images[5] is string && images[5].size() <= 2048))
        && (images.size() < 7 || (images[6] is string && images[6].size() <= 2048))
        && (images.size() < 8 || (images[7] is string && images[7].size() <= 2048));
    }

    function validStoredDate(value) {
      return value is timestamp
        || (value is string && value.size() >= 20 && value.size() <= 40);
    }

    function validProduct(data, productId) {
      return data.keys().hasAll([
          'id', 'title', 'description', 'price', 'category', 'listingType',
          'priceNegotiable', 'serviceArea', 'availability', 'city', 'country',
          'address', 'latitude', 'longitude', 'images', 'sellerId',
          'sellerName', 'sellerPhoto', 'sellerPhone', 'sellerEmail',
          'condition', 'isFeatured', 'isSold', 'views', 'favorites',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'title', 'description', 'price', 'category', 'listingType',
          'priceNegotiable', 'serviceArea', 'availability', 'city', 'country',
          'address', 'latitude', 'longitude', 'images', 'sellerId',
          'sellerName', 'sellerPhoto', 'sellerPhone', 'sellerEmail',
          'condition', 'isFeatured', 'isSold', 'views', 'favorites',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == productId && data.id.size() <= 160
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.description is string && data.description.size() >= 1
        && data.description.size() <= 3000
        && data.price is number && data.price >= 0 && data.price <= 1000000000
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 60
        && data.listingType is string && data.listingType in ['product', 'service']
        && data.priceNegotiable is bool
        && data.serviceArea is string && data.serviceArea.size() <= 300
        && data.availability is string && data.availability.size() <= 300
        && ((data.listingType == 'product'
              && data.priceNegotiable == false && data.price > 0
              && data.serviceArea == '' && data.availability == '')
            || (data.listingType == 'service'
              && data.condition == 'No aplica'
              && data.serviceArea.size() >= 2
              && data.availability.size() >= 2
              && ((data.priceNegotiable == true && data.price == 0)
                || (data.priceNegotiable == false && data.price > 0))))
        && data.city is string && data.city.size() <= 120
        && data.country is string && data.country.size() >= 2 && data.country.size() <= 80
        && data.address is string && data.address.size() <= 300
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && validImageList(data.images)
        && data.sellerId is string && data.sellerId.size() >= 1 && data.sellerId.size() <= 128
        && data.sellerName is string && data.sellerName.size() <= 160
        && data.sellerPhoto is string && data.sellerPhoto.size() <= 2048
        && data.sellerPhone is string && data.sellerPhone.size() <= 40
        && data.sellerEmail is string && data.sellerEmail.size() <= 254
        && data.condition is string && data.condition.size() >= 1 && data.condition.size() <= 40
        && data.isFeatured is bool && data.isSold is bool
        && data.views is int && data.views >= 0
        && data.favorites is int && data.favorites >= 0
        && validStoredDate(data.createdAt) && validStoredDate(data.updatedAt);
    }

    match /users/{uid} {
      allow read: if owner(uid) || admin();
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.reputation == 5;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'lastName', 'phone', 'country', 'city', 'address',
          'language', 'photo'
        ]);
      allow delete: if false;

      match /favorites/{productId} {
        allow read: if owner(uid);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if owner(uid);
        allow update: if owner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }
    }

    // Perfil seguro para mostrar a otros usuarios. Se mantiene desde el
    // backend; el cliente no puede falsificar reputación ni verificación.
    match /publicProfiles/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn()
        && validProduct(request.resource.data, productId)
        && request.resource.data.id == productId
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.views == 0
        && request.resource.data.favorites == 0
        && request.resource.data.isFeatured == false
        && request.resource.data.isSold == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn()
        && resource.data.sellerId == request.auth.uid
        && validProduct(request.resource.data, productId)
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.id == resource.data.id
        && ((!resource.data.keys().hasAll(['listingType'])
              && request.resource.data.listingType == 'product')
            || (resource.data.keys().hasAll(['listingType'])
              && request.resource.data.listingType == resource.data.listingType))
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'price', 'category', 'listingType',
          'priceNegotiable', 'serviceArea', 'availability', 'city', 'country',
          'address', 'latitude', 'longitude', 'images', 'condition',
          'isSold', 'updatedAt'
        ]);
      allow delete: if signedIn() && resource.data.sellerId == request.auth.uid;

      match /viewEvents/{viewerId} {
        allow read, write: if false;
      }
    }

    match /reviews/{reviewId} {
      allow read: if signedIn()
        && (resource.data.status == 'published'
          || resource.data.sellerId == request.auth.uid
          || resource.data.reviewerId == request.auth.uid
          || staff());
      allow write: if false;
    }

    match /reviewInteractions/{interactionId} {
      allow read: if signedIn()
        && (resource.data.reviewerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
          || staff());
      allow write: if false;
    }

    match /reviewReports/{reportId} {
      allow read: if signedIn()
        && (resource.data.reporterId == request.auth.uid || staff());
      allow write: if false;
    }

    match /moderationAudit/{auditId} {
      allow read: if staff();
      allow write: if false;
    }

    match /supportTickets/{ticketId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || support() || admin());
      allow create, update, delete: if false;

      match /responses/{responseId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/supportTickets/$(ticketId))
                .data.userId == request.auth.uid
            || support() || admin());
        allow write: if false;
      }
    }

    match /supportAudit/{auditId} {
      allow read: if support() || admin();
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && resource.data.participantIds is list
        && resource.data.participantIds.size() == 2
        && resource.data.participantIds[0] != resource.data.participantIds[1]
        && request.auth.uid in resource.data.participantIds;
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.participantIds;
        allow create, update, delete: if false;
      }
    }

    match /messages/{messageId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
